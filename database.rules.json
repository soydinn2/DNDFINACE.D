{
"rules": {
".read": false,
".write": false,
"_health_check": {
".read": true,
".write": true
},
"workspaces": {
"$account_key": {
".read": true,
".write": true,
".validate": "newData.hasChildren(['account_key', 'revision', 'state', 'updated_at']) && newData.child('revision').isNumber()"
}
},
"receipt_scans": {
".indexOn": ["account_key", "created_at"],
"$scan_id": {
".read": true,
".write": true,
".validate": "newData.hasChildren(['account_key', 'grand_total', 'created_at']) && newData.child('grand_total').isNumber()"
}
},
"report_files": {
".indexOn": ["account_key", "created_at"],
"$file_id": {
".read": true,
".write": true,
".validate": "newData.hasChildren(['account_key', 'filename', 'file_format', 'direction', 'created_at'])"
}
}
}
}
