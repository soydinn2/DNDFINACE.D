rules_version = '2';
​service cloud.firestore {
match /databases/{database}/documents {
match /workspaces/{accountKey} {
allow read, write: if request.resource.data.keys().hasAll([
'account_key',
'revision',
'state',
'updated_at'
]);
}
​match /receipt_scans/{scanId} {
allow read, write: if request.resource.data.keys().hasAll([
'account_key',
'grand_total',
'created_at'
]);
}
​match /report_files/{fileId} {
allow read, write: if request.resource.data.keys().hasAll([
'account_key',
'filename',
'file_format',
'direction',
'created_at'
]);
}
​match /{document=} {
allow read, write: if false;
}
}
}
