{
"$schema": "https://openapi.vercel.sh/vercel.json",
"version": 2,
"functions": {
"api/index.py": {
"maxDuration": 30,
"includeFiles": "{index.html,main.py,database.rules.json,firestore.rules,env.example,requirements.txt}"
}
},
"rewrites": [
{
"source": "/api/(.)",
"destination": "/api/index.py"
},
{
"source": "/(.)",
"destination": "/api/index.py"
}
]
}
