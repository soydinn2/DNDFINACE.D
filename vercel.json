{
"$schema": "https://openapi.vercel.sh/vercel.json",
"version": 2,
"functions": {
"api/index.py": {
"runtime": "@vercel/python",
"maxDuration": 30,
"includeFiles": "{index.html,main.py,database.rules.json,firestore.rules,.env,env.example}"
}
},
"routes": [
{
"src": "/api/(.)",
"dest": "/api/index.py"
},
{
"src": "/(.)",
"dest": "/api/index.py"
}
]
}
